# GTPS Assistant: optional environment variables.
# Copy to .env.local (ignored by git). Never commit real keys.
#
# API keys can instead be entered in Settings -> AI Providers; a key saved there
# is stored in data/ai-config.json (local, gitignored) and takes precedence.
# Keys are only ever used by the local backend and are never sent to the browser.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Where saved keys and default provider/model are stored.
# GTPS_AI_CONFIG_PATH=data/ai-config.json

# Extra host names allowed to call /api/ai/* (comma separated). localhost,
# 127.0.0.1 and [::1] are always allowed; others are refused to block
# DNS-rebinding attacks. Only needed if you open the app by another name.
# GTPS_ALLOWED_HOSTS=

# Database file for the documentation index.
# GTPS_DB_PATH=data/gtps-assistant.db

# Hosted deployments (Vercel etc.): password that unlocks the backend (min. 8 characters).
# Without it the backend stays locked. Keys must then come from GEMINI_API_KEY / GROQ_API_KEY above.
# GTPS_ACCESS_PASSWORD=

# Force "hosted mode" (backend disabled, only the browser features work).
# Detected automatically on Vercel, Netlify, AWS Lambda and Cloud Run; normally you do not set this.
# GTPS_HOSTED=1
